{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": false,
    "resources": {
      "resources/ffmpeg/*": null,
      "resources/licenses/OpenH264.txt": "licenses/OpenH264.txt",
      "../.cache/macos-av1-runtime/licenses/": "licenses/av1/",
      "../.cache/macos-av1-runtime/manifest.json": "licenses/av1/manifest.json"
    },
    "macOS": {
      "frameworks": ["../.cache/macos-av1-runtime/libpastepanda_av1.dylib"],
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.macos.plist"
    }
  },
  "app": {
    "macOSPrivateApi": true
  }
}
