# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# ocr-rs vendoring：预编译 MNN（解压后约 120MB）不入库（单文件已近 60MB，
# 超 GitHub 100MB 限制），构建时由 build.rs 从 MNN-Prebuilds 下载，并用
# actions/cache 在 CI 间缓存（build.rs 的 MNN_PREBUILT_CHECKOUT_CACHE=1
# 才会写进这个目录，否则缓存是空转的），避免每次构建联网下载。
# 本地开发把 MNN 放到此目录即可离线构建。
vendor/ocr-rs/3rd_party/
