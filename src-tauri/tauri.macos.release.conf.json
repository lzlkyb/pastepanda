{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "Entitlements.macos.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/lzlkyb/pastepanda/releases/latest/download/updater-macos.json"
      ]
    }
  }
}
