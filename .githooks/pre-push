#!/bin/sh
# ────────────────────────────────────────────────────
#  pre-push — push 前自动运行前端 + Rust 测试
#
#  安装：cp .githooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#  跳过：git push --no-verify
# ────────────────────────────────────────────────────

set -e

echo ""
echo "══════════════════════════════════════════════"
echo "  Pre-push: 运行测试..."
echo "══════════════════════════════════════════════"
echo ""

# ── 前端测试 ──────────────────────────────────────
echo "[1/2] 前端 Vitest..."
npx vitest --run
echo "  ✅ 前端测试通过"
echo ""

# ── Rust 测试 ─────────────────────────────────────
echo "[2/2] Rust cargo test..."
cd src-tauri && cargo test
echo "  ✅ Rust 测试通过"
echo ""

echo "══════════════════════════════════════════════"
echo "  全部测试通过 ✅  开始 push..."
echo "══════════════════════════════════════════════"
