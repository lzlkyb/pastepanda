#!/bin/sh
# ────────────────────────────────────────────────────
#  pre-push — push 前自动跑密钥守卫 + 前端 + Rust 测试
#
#  生效的是这一份：core.hooksPath=.husky/_，husky 的 shim 再调本文件。
#  `.githooks/pre-push` 是「不用 husky 时」的等价副本，改这里必须同步它——
#  2026-10-08 实测两份已漂移：旧副本缺 `--pool=forks` 和 LIBCLANG_PATH 注入，
#  照原来那句「cp .githooks/pre-push」装上去，cargo test 会因找不到 libclang 编不过。
#  跳过：git push --no-verify
# ────────────────────────────────────────────────────

set -e

echo ""
echo "══════════════════════════════════════════════"
echo "  Pre-push: 守卫 + 测试..."
echo "══════════════════════════════════════════════"
echo ""

# ── 密钥明文守卫 ────────────────────────────
# v6.10.0 的教训：一个测试用的假 Slack token 让 GitHub push protection
# 直接拒了 push（GH013），而那时 commit 已经建好、tag 也已打上，
# 只能 amend 重写 + 重打 tag。在本地提前拦，代价只是改一行。
# 2026-10-09 起是秒级：合并成 2 趟 + 剔掉「0 个被追踪文件」的构建缓存目录后本机实测 10.2s
# （历史：4 趟全树 grep -rn ≈499s）。排除名单由脚本开头的 git ls-files 断言自证，
# 反例在 src/__tests__/secretGuardCanary.test.ts。
echo "[1/3] 密钥明文守卫..."
bash tools/check_no_plaintext_secrets.sh
echo ""

# ── 前端测试 ──────────────────────────────────────
echo "[2/3] 前端 Vitest..."
# vitest 4 的默认 pool 已经是 forks，这里显式重复一遍只是不让钩子依赖配置文件没被改坏。
# 真正封顶并发的是 vitest.config.ts 的 maxWorkers（4 里没有 poolOptions 这个键，别往回写）。
npx vitest --run --pool=forks
echo "  ✅ 前端测试通过"
echo ""

# ── Rust 测试 ─────────────────────────────────────
echo "[3/3] Rust cargo test..."
# ocr-rs (vendored) 的 bindgen 需要 libclang.dll，项目自带于 src-tauri/.libclang。
# 若该目录存在则注入 LIBCLANG_PATH；CI/其他环境无此目录时走系统 clang，不影响。
if [ -d "src-tauri/.libclang" ]; then
  export LIBCLANG_PATH="$(cygpath -w "$(pwd)/src-tauri/.libclang")"
fi
cd src-tauri && cargo test
echo "  ✅ Rust 测试通过"
echo ""

echo "══════════════════════════════════════════════"
echo "  全部测试通过 ✅  开始 push..."
echo "══════════════════════════════════════════════"
