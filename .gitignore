.env.secrets

# Runtime config backups (rotated by the app, not source)
src-tauri/config_backups/

# 早期会话的临时产物（图片 base64 中转、暂缓的测试草稿）
melody_b64.txt
*.test.ts.pending

# codegraph 索引产物（本地生成，勿入库）
.codegraph/

# Python 字节码（.pyc 里会带上运行时用过的字符串）
# 原来只写 tools/__pycache__/，结果 scripts/__pycache__/build-easytier.cpython-312.pyc
# 一路顺畅进了库（2026-10-08 入库审计实测）。
__pycache__/
*.pyc
# 项目记忆（工作日志，本地开发档案，不入库）
.codebuddy/
src-tauri/.libclang/
.workbuddy/

# 本地诊断 / 构建杂项（勿入库）
.rcgen.json
src-tauri/_rust.txt

# hyperframes 视频工程（design/promo/ 的渲染工具，~445MB 全是本地依赖）
# 只保留依赖清单用于复现渲染环境；node_modules（361MB）与 .bin/ffmpeg.exe（87MB）不入库。
# 注意必须写 `/*` 而不是忽略整个目录：父目录一旦被 ignore，git 就不会再进入其内部，
# 届时 `!package.json` 不生效，依赖清单会被静默漏掉。
design/promo/hyperframes/*
!design/promo/hyperframes/package.json
!design/promo/hyperframes/package-lock.json

# 09-24：FFmpeg LGPL 对照台（probe/_av/）—— 182MB 解压产物与 zip 不入库。
# 只保留两个脚本：enc_probe.sh（逐路实测出首包）/ nal_stats.py（判 IDR 是否自带 SPS/PPS）。
# 同 design/promo 的教训：写 `/*` 而不是忽略整个目录。
probe/_av/ffmpeg-master-latest-win64-lgpl-shared/*
probe/_av/*.zip

# 根目录 target（误生成；Rust 构建目标在 src-tauri/target，已由 src-tauri/.gitignore 管理）
target/

# impeccable 设计审查工具的本地产物（critique / live 会话，勿入库）
.impeccable/

# 崩溃报告导出的半成品后缀（导出中断留下的 0 字节残留）
*.pppart

# ── 2026-10-01 审查工作区时补的四类（213 项变更里逐个确认过）──
# Android 生成工程：`tauri android init` 产物，1.3GB 且内嵌本机 NDK 路径，
# 原生源码在 src-tauri/android/，scripts/prepare-android.mjs 在 android:* 前
# 自动恢复 Kotlin 类和清单权限；初始化后无需手工补回。
src-tauri/gen/
# 误操作把 gen 拷进了自己（src-tauri/src-tauri/gen/android/…），嵌套副本勿入库
src-tauri/src-tauri/
# 移动端构建产物（桌面侧只忽略了 dist/dist-ssr，漏了它）
dist-mobile/
# WebCodecs 探针页的本地 TLS 私钥（cert.pem + key.pem），永不入库
design/probe-cert/


# ── 2026-10-03 工作区审计时补的本地产物/缓存（逐个确认可再生）──
# Android 专用 cargo 编译缓存（与桌面 target/ 隔离用，规则 20），纯构建产物
src-tauri/target-android/
# 各会话的临时探针/日志/演示工程缓存目录
.cache/
# 运行时配置备份（save_config 的全量明文备份落盘处，机器本地）
config_backups/
# 装机验证留下的临时 APK 与 cargo registry 快照探针输出
new-installed.apk
rd_files.json
# 宣传视频渲染素材/产物（体积大且可由 scripts/promo-* 再生）
videos/

# macOS build cache, isolated from Windows and Android
src-tauri/target-macos/
src-tauri/target-macos-intel/

# ── 2026-10-08 入库审计补的四条（逐条用 git check-ignore 问过「未忽略」才加）──
# cargo vendor 每次重跑都会留「补丁前副本」；仓里那两个 Cargo.toml.orig 就是这么进来的，
# 编译链不读它们，只有 vendor 出来的 Cargo.toml 第 10 行一句注释提到。
*.orig
# 脚本/编辑器中断留下的备份（同 *.pppart 那类半成品）
*.bak
# scripts/ 下有 Python（build-easytier.py、promo-verify.py），谁都可能顺手建虚拟环境；
# 本机绝对路径写死在 pyvenv.cfg 里，入库即污染别人环境。
.venv/
venv/
