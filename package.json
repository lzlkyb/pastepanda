    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.40.0",
    "highlight.js": "^11.11.1",
    "lenis": "^1.3.25",
    "lucide-react": "^1.21.0",
    "marked": "^18.0.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-simple-code-editor": "^0.14.1",
    "shiki": "^4.3.0",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "zustand": "^5.0.14"
